---
import "../styles/global.css";
import LanguageSwitch from "../components/LanguageSwitch.astro";

interface Props {
	title: string;
	description?: string;
	language?: "fr" | "en";
	frenchUrl?: string;
	englishUrl?: string;
	maxWidth?: string;
	fullBleed?: boolean;
}

const {
	title,
	description = "Le mariage de Jeanne & Maxime",
	language = "fr",
	frenchUrl = "/",
	englishUrl = "/en/",
	maxWidth = "max-w-5xl",
	fullBleed = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const prefixedFrenchUrl = `${base}${frenchUrl}`;
const prefixedEnglishUrl = `${base}${englishUrl}`;
---

<html lang={language}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />

		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />

		<title>{title}</title>
	</head>

	<body class="bg-[var(--ivory)] text-[var(--text)]">
		<main class:list={[
			"relative min-h-screen",
			fullBleed ? "overflow-hidden" : "px-8 py-24 sm:px-16",
		]}>

			<div
				class="pointer-events-none fixed inset-4 z-20 border border-[var(--terracotta)]/50 sm:inset-6"
			></div>

			<LanguageSwitch
				currentLanguage={language}
				frenchUrl={prefixedFrenchUrl}
				englishUrl={prefixedEnglishUrl}
			/>

			{
				fullBleed ? (
					<slot />
				) : (
					<div class={`mx-auto ${maxWidth}`}>
						<slot />
					</div>
				)
			}

		</main>
	</body>
</html>
