---
import "../styles/global.css";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Le week-end — Jeanne & Maxime</title>
	</head>

	<body class="bg-[var(--ivory)] text-[var(--text)]">
		<main class="relative min-h-screen px-8 py-24 sm:px-16">
			<div
				class="pointer-events-none fixed inset-4 border border-[var(--terracotta)]/50 sm:inset-6"
			></div>

			<div class="mx-auto max-w-4xl">
				<a
					href="/#menu"
					class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--sage)]"
				>
					← Retour
				</a>

				<header class="py-20 text-center">
					<p class="font-serif text-sm uppercase tracking-[0.4em] text-[var(--sage)]">
						Deux jours ensemble
					</p>

					<h1 class="mt-5 font-serif text-6xl text-[var(--olive)] sm:text-7xl">
						Le week-end
					</h1>

					<div class="mx-auto my-8 h-px w-16 bg-[var(--terracotta)]/60"></div>
				</header>

				<section class="space-y-12">
					<div class="border-l border-[var(--terracotta)] pl-8">
						<p class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--terracotta)]">
							Samedi
						</p>

						<h2 class="mt-2 font-serif text-4xl text-[var(--olive)]">
							Le mariage
						</h2>

						<p class="mt-4 leading-relaxed text-[var(--sage)]">
							La cérémonie, le cocktail, le dîner et la soirée.
						</p>
					</div>

					<div class="border-l border-[var(--terracotta)] pl-8">
						<p class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--terracotta)]">
							Dimanche
						</p>

						<h2 class="mt-2 font-serif text-4xl text-[var(--olive)]">
							Le retour de noces
						</h2>

						<p class="mt-4 leading-relaxed text-[var(--sage)]">
							Nous vous retrouverons le lendemain pour prolonger les festivités.
						</p>
					</div>

					<div class="grid gap-8 pt-8 md:grid-cols-2">
						<div class="border border-[var(--sage)]/25 p-8">
							<h3 class="font-serif text-3xl text-[var(--olive)]">
								Hébergement
							</h3>

							<p class="mt-4 leading-relaxed text-[var(--sage)]">
								Nous ajouterons ici une sélection d'hôtels, chambres d'hôtes
								et logements à proximité.
							</p>
						</div>

						<div class="border border-[var(--sage)]/25 p-8">
							<h3 class="font-serif text-3xl text-[var(--olive)]">
								À proximité
							</h3>

							<p class="mt-4 leading-relaxed text-[var(--sage)]">
								Quelques bonnes adresses et idées pour profiter de la région.
							</p>
						</div>
					</div>
				</section>
			</div>
		</main>
	</body>
</html>