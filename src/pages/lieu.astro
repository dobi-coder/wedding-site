---
import BaseLayout from "../layouts/BaseLayout.astro";
import TransportIcon from "../components/TransportIcon.astro";
---

<BaseLayout
	title="Le lieu — Jeanne & Maxime"
	description="Découvrez le Château de Saint-Cyr-du-Gault, lieu de notre mariage."
	language="fr"
	frenchUrl="/lieu"
	englishUrl="/en/venue"
	maxWidth="max-w-5xl"
>
	<a
		href="/#bienvenue"
		class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--sage)] transition-colors hover:text-[var(--terracotta)]"
	>
		← Retour
	</a>

	<header class="py-16 text-center sm:py-20">
		<p class="font-serif text-sm uppercase tracking-[0.4em] text-[var(--sage)]">
			Le domaine
		</p>

		<h1 class="mt-5 font-serif text-5xl text-[var(--olive)] sm:text-7xl">
			Le lieu
		</h1>

		<div class="mx-auto my-8 h-px w-16 bg-[var(--terracotta)]/60"></div>

		<p class="font-script text-4xl text-[var(--terracotta)] sm:text-5xl">
			Château de Saint-Cyr-du-Gault
		</p>
	</header>

	<section class="py-4 sm:py-8">
        <div class="mx-auto max-w-4xl">
            <img
                src="/images/chateau-sticky-note.png"
                alt="Photo du Château de Saint-Cyr-du-Gault présentée dans un style carnet de voyage"
                class="mx-auto w-full max-w-4xl object-contain"
            />
        </div>
    </section>

	<section class="mx-auto max-w-3xl py-16 text-center sm:py-20">
		<p class="font-serif text-2xl leading-relaxed text-[var(--olive)] sm:text-3xl">
			C’est au Château de Saint-Cyr-du-Gault, au cœur du Loir-et-Cher, que nous vous
            retrouverons pour célébrer ce week-end ensemble.
		</p>

		<div class="mx-auto my-10 h-px w-12 bg-[var(--terracotta)]/60"></div>

		<p class="text-sm uppercase tracking-[0.25em] text-[var(--sage)]">
			34 Rue de la République
			<br />
			41190 Saint-Cyr-du-Gault
			<br />
			France
		</p>

		<a
			href="https://www.google.com/maps/search/?api=1&query=Château+de+Saint-Cyr-du-Gault,+34+Rue+de+la+République,+41190+Saint-Cyr-du-Gault,+France"
			target="_blank"
			rel="noopener noreferrer"
			class="mt-8 inline-block border border-[var(--terracotta)] px-7 py-3 font-serif text-lg text-[var(--terracotta-dark)] transition-all duration-300 hover:bg-[var(--terracotta)] hover:text-white"
		>
			Voir sur Google Maps
		</a>
	</section>

    <!-- Practical information -->
    <section class="py-16">
        <div class="text-center">
            <p class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--terracotta)]">
                Venir au château
            </p>

            <h2 class="mt-4 font-serif text-4xl text-[var(--olive)]">
                Accès
            </h2>

            <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-[var(--sage)]">
                Voici quelques itinéraires conseillés pour rejoindre le château.
                Les horaires précis seront à vérifier à l'approche du mariage.
            </p>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-3">

            <!-- Paris -->
            <div class="border border-[var(--sage)]/25 bg-[var(--paper)]/60 p-8">
                <h3 class="font-serif text-3xl text-[var(--olive)]">
                    Depuis Paris
                </h3>

                <!-- Train -->
                <div class="mt-7">
                    <div class="flex items-center gap-3">
                        <TransportIcon type="train" />
                        <h4 class="font-serif text-xl text-[var(--terracotta-dark)]">
                            En train
                        </h4>
                    </div>

                    <p class="mt-4 leading-relaxed text-[var(--sage)]">
                        Le plus simple est de prendre un TGV depuis
                        <strong> Paris Gare Montparnasse </strong> en direction de
                        <strong> Vendôme - Villiers-sur-Loir </strong>.
                    </p>

                    <p class="mt-3 leading-relaxed text-[var(--sage)]">
                        Le trajet ferroviaire prend environ
                        <strong> 45 min</strong>.
                    </p>

                    <p class="mt-3 leading-relaxed text-[var(--sage)]">
                        Ensuite, comptez environ
                        <strong> 30 min en voiture ou taxi </strong>
                        jusqu'au château.
                    </p>
                </div>

                <!-- Separator -->
                <div class="my-8 h-px bg-[var(--terracotta)]/25"></div>

                <!-- Car -->
                <div>
                    <div class="flex items-center gap-3">
                        <TransportIcon type="car" />
                        <h4 class="font-serif text-xl text-[var(--terracotta-dark)]">
                            En voiture
                        </h4>
                    </div>

                    <p class="mt-4 leading-relaxed text-[var(--sage)]">
                        Le château est également accessible directement en voiture
                        depuis Paris.
                    </p>

                    <p class="mt-3 leading-relaxed text-[var(--sage)]">
                        Comptez environ <strong>2 h 30 min de route</strong>,
                        selon la circulation.
                    </p>
                </div>
            </div>

            <!-- Lille -->
            <div class="border border-[var(--sage)]/25 bg-[var(--paper)]/60 p-8">
                <h3 class="font-serif text-3xl text-[var(--olive)]">
                    Depuis Lille
                </h3>

                <!-- Train -->
                <div class="mt-7">
                    <div class="flex items-center gap-3">
                        <TransportIcon type="train" />
                        <h4 class="font-serif text-xl text-[var(--terracotta-dark)]">
                            En train
                        </h4>
                    </div>

                    <p class="mt-4 leading-relaxed text-[var(--sage)]">
                        Des trajets en train permettent de rejoindre
                        <strong> Blois–Chambord: </strong>Lille - Paris Nord - Paris Austerlitz - Blois–Chambord.
                    </p>

                    <p class="mt-3 leading-relaxed text-[var(--sage)]">
                        Comptez environ
                        <strong> 3 h 40 à 4 h 30 </strong>
                        selon les correspondances.
                    </p>

                    <p class="mt-3 leading-relaxed text-[var(--sage)]">
                        Ensuite, comptez environ
                        <strong> 35 min en voiture ou taxi </strong>
                        jusqu'au château.
                    </p>
                </div>

                <!-- Separator -->
                <div class="my-8 h-px bg-[var(--terracotta)]/25"></div>

                <!-- Car -->
                <div>
                    <div class="flex items-center gap-3">
                        <TransportIcon type="car" />
                        <h4 class="font-serif text-xl text-[var(--terracotta-dark)]">
                            En voiture
                        </h4>
                    </div>

                    <p class="mt-4 leading-relaxed text-[var(--sage)]">
                        Il est également possible de rejoindre directement le château
                        en voiture depuis Lille.
                    </p>

                    <p class="mt-3 leading-relaxed text-[var(--sage)]">
                        Comptez environ <strong> 4 h 30 de route </strong>,
                        selon la circulation.
                    </p>
                </div>
            </div>

            <!-- Cambridge -->
            <div class="border border-[var(--sage)]/25 bg-[var(--paper)]/60 p-8">
                <h3 class="font-serif text-3xl text-[var(--olive)]">
                    Depuis Cambridge
                </h3>

                <!-- Train -->
                <div class="mt-7">
                    <div class="flex items-center gap-3">
                        <TransportIcon type="train" />
                        <h4 class="font-serif text-xl text-[var(--terracotta-dark)]">
                            En train
                        </h4>
                    </div>

                    <p class="mt-4 leading-relaxed text-[var(--sage)]">
                        Depuis Cambridge, rejoignez
                        <strong> London St Pancras </strong>, puis prenez
                        <strong> l'Eurostar jusqu'à Paris Gare du Nord </strong>.
                    </p>

                    <p class="mt-3 leading-relaxed text-[var(--sage)]">
                        L'Eurostar relie Londres à Paris en environ
                        <strong> 2 h 20</strong>.
                    </p>

                    <p class="mt-3 leading-relaxed text-[var(--sage)]">
                        Depuis Paris, rejoignez ensuite
                        <strong> Gare Montparnasse </strong> pour prendre un TGV
                        jusqu'à <strong> Vendôme - Villiers-sur-Loir</strong>.
                    </p>

                    <p class="mt-3 leading-relaxed text-[var(--sage)]">
                        Depuis Vendôme, comptez environ
                        <strong> 30 min en voiture ou taxi </strong>
                        jusqu'au château.
                    </p>
                </div>

                <!-- Separator -->
                <div class="my-8 h-px bg-[var(--terracotta)]/25"></div>

                <!-- Plane -->
                <div>
                    <div class="flex items-center gap-3">
                        <TransportIcon type="plane" />
                        <h4 class="font-serif text-xl text-[var(--terracotta-dark)]">
                            En avion
                        </h4>
                    </div>

                    <p class="mt-4 leading-relaxed text-[var(--sage)]">
                        Il est également possible de rejoindre le château en avion depuis London Stansted vers Tours. 
                    </p>
                    <a
                        href="https://www.ryanair.com/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-5 inline-block border border-[var(--terracotta)] px-5 py-2 font-serif text-base text-[var(--terracotta-dark)] transition-all duration-300 hover:bg-[var(--terracotta)] hover:text-white"
                    >
                        Voir les vols sur Ryanair
                    </a>

                    <p class="mt-4 leading-relaxed text-[var(--sage)]">
                        Une voiture de location pourra être une bonne option pour rejoindre
                        le château et se déplacer pendant le week-end.
                    </p>
                </div>
            </div>

        </div>
    </section>

</BaseLayout>
