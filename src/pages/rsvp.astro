---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
	title="RSVP — Jeanne & Maxime"
	description="Confirmez votre présence au mariage de Jeanne & Maxime."
	language="fr"
	frenchUrl="/rsvp"
	englishUrl="/en/rsvp"
	maxWidth="max-w-2xl"
>
	<a
		href={`${base}/#bienvenue`}
		class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--sage)] transition-colors hover:text-[var(--terracotta)]"
	>
		← Retour
	</a>

	<header class="py-16 text-center sm:py-20">
		<p
			class="font-serif text-sm uppercase tracking-[0.4em] text-[var(--sage)]"
		>
			Votre réponse
		</p>

		<h1
			class="mt-5 font-serif text-6xl text-[var(--olive)] sm:text-7xl"
		>
			RSVP
		</h1>

		<div
			class="mx-auto my-8 h-px w-16 bg-[var(--terracotta)]/60"
		></div>

		<p class="font-serif text-xl text-[var(--sage)]">
			Merci de nous répondre avant le 1er juin 2027.
		</p>
	</header>

	<section class="pb-24">
		<form
			action="https://formspree.io/f/mvkopplj"
			method="POST"
			class="space-y-10"
		>
			<input
				type="hidden"
				name="_subject"
				value="Nouvelle réponse RSVP — Mariage Jeanne & Maxime"
			/>

			<!-- Name -->
			<div>
				<label
					for="name"
					class="mb-3 block font-serif text-lg text-[var(--olive)]"
				>
					Nom et prénom
				</label>

				<input
					type="text"
					id="name"
					name="Nom et prénom"
					required
					autocomplete="name"
					class="w-full border border-[var(--sage)]/30 bg-[var(--paper)]/50 px-5 py-4
					font-serif text-lg text-[var(--olive)] outline-none
					transition-colors duration-300
					focus:border-[var(--terracotta)]"
				/>
			</div>

			<!-- Email -->
			<div>
				<label
					for="email"
					class="mb-3 block font-serif text-lg text-[var(--olive)]"
				>
					Adresse e-mail
				</label>

				<input
					type="email"
					id="email"
					name="email"
					autocomplete="email"
					class="w-full border border-[var(--sage)]/30 bg-[var(--paper)]/50 px-5 py-4
					font-serif text-lg text-[var(--olive)] outline-none
					transition-colors duration-300
					focus:border-[var(--terracotta)]"
				/>
			</div>

			<!-- Attendance -->
			<fieldset>
				<legend
					class="mb-4 font-serif text-lg text-[var(--olive)]"
				>
					Serez-vous parmi nous ?
				</legend>

				<div class="space-y-3">
					<label
						class="flex cursor-pointer items-center gap-4 border border-[var(--sage)]/25
						bg-[var(--paper)]/40 px-5 py-4 transition-colors
						hover:border-[var(--terracotta)]"
					>
						<input
							type="radio"
							name="Présence"
							value="Oui"
							required
							data-attendance="yes"
							class="accent-[var(--terracotta)]"
						/>

						<span class="font-serif text-lg text-[var(--sage)]">
							Avec plaisir !
						</span>
					</label>

					<label
						class="flex cursor-pointer items-center gap-4 border border-[var(--sage)]/25
						bg-[var(--paper)]/40 px-5 py-4 transition-colors
						hover:border-[var(--terracotta)]"
					>
						<input
							type="radio"
							name="Présence"
							value="Non"
							data-attendance="no"
							class="accent-[var(--terracotta)]"
						/>

						<span class="font-serif text-lg text-[var(--sage)]">
							Malheureusement, nous ne pourrons pas être présents.
						</span>
					</label>
				</div>
			</fieldset>

			<!-- Only shown if attending -->
			<div
				id="attendance-details"
				class="hidden space-y-10"
			>
				<!-- Attendee names -->
				<div>
					<label
						for="guest-names"
						class="mb-3 block font-serif text-lg text-[var(--olive)]"
					>
						Nom et prénom de chaque personne présente
					</label>

					<textarea
						id="guest-names"
						name="Noms des personnes présentes"
						rows="3"
						disabled
						placeholder="Une personne par ligne"
						class="w-full resize-none border border-[var(--sage)]/30 bg-[var(--paper)]/50
						px-5 py-4 font-serif text-lg text-[var(--olive)] outline-none
						placeholder:text-[var(--sage)]/50
						transition-colors duration-300
						focus:border-[var(--terracotta)]"
					></textarea>

					<p
						class="mt-2 text-sm italic text-[var(--sage)]/70"
					>
						Merci d’indiquer votre nom ainsi que celui de chaque personne incluse dans cette réponse.
					</p>
				</div>

				<!-- Sunday -->
				<fieldset>
					<legend
						class="mb-4 font-serif text-lg text-[var(--olive)]"
					>
						Serez-vous également présents le dimanche ?
					</legend>

					<div class="flex flex-col gap-3 sm:flex-row">
						<label
							class="flex flex-1 cursor-pointer items-center gap-4 border
							border-[var(--sage)]/25 bg-[var(--paper)]/40 px-5 py-4
							transition-colors hover:border-[var(--terracotta)]"
						>
							<input
								type="radio"
								name="Présence dimanche"
								value="Oui"
								class="accent-[var(--terracotta)]"
							/>

							<span class="font-serif text-lg text-[var(--sage)]">
								Oui
							</span>
						</label>

						<label
							class="flex flex-1 cursor-pointer items-center gap-4 border
							border-[var(--sage)]/25 bg-[var(--paper)]/40 px-5 py-4
							transition-colors hover:border-[var(--terracotta)]"
						>
							<input
								type="radio"
								name="Présence dimanche"
								value="Non"
								class="accent-[var(--terracotta)]"
							/>

							<span class="font-serif text-lg text-[var(--sage)]">
								Non
							</span>
						</label>
					</div>
				</fieldset>

				<!-- Dietary requirements -->
				<div>
					<label
						for="dietary"
						class="mb-3 block font-serif text-lg text-[var(--olive)]"
					>
						Allergies ou régime alimentaire
					</label>

					<textarea
						id="dietary"
						name="Allergies / régime alimentaire"
						rows="3"
						placeholder="Végétarien, allergies, intolérances..."
						class="w-full resize-none border border-[var(--sage)]/30 bg-[var(--paper)]/50
						px-5 py-4 font-serif text-lg text-[var(--olive)] outline-none
						placeholder:text-[var(--sage)]/50
						transition-colors duration-300
						focus:border-[var(--terracotta)]"
					></textarea>
				</div>
			</div>

			<!-- Message -->
			<div>
				<label
					for="message"
					class="mb-3 block font-serif text-lg text-[var(--olive)]"
				>
					Un petit mot
					<span class="text-[var(--sage)]/60">
						(facultatif)
					</span>
				</label>

				<textarea
					id="message"
					name="Message"
					rows="4"
					class="w-full resize-none border border-[var(--sage)]/30 bg-[var(--paper)]/50
					px-5 py-4 font-serif text-lg text-[var(--olive)] outline-none
					transition-colors duration-300
					focus:border-[var(--terracotta)]"
				></textarea>
			</div>

			<!-- Submit -->
			<div class="pt-4 text-center">
				<button
					type="submit"
					class="border border-[var(--terracotta)] px-10 py-4
					font-serif text-lg text-[var(--terracotta-dark)]
					transition-all duration-300
					hover:-translate-y-1
					hover:bg-[var(--terracotta)]
					hover:text-white"
				>
					Envoyer notre réponse
				</button>
			</div>
		</form>

		<!-- Decorative ending -->
		<div
			class="mx-auto mt-16 flex max-w-xs items-center gap-4"
		>
			<div
				class="h-px flex-1 bg-[var(--sage)]/20"
			></div>

			<span class="font-serif text-xs tracking-[0.3em] text-[var(--terracotta-dark)]">J · M</span>

			<div
				class="h-px flex-1 bg-[var(--sage)]/20"
			></div>
		</div>
	</section>

	<script>
		const yesRadio = document.querySelector(
			'[data-attendance="yes"]'
		);

		const noRadio = document.querySelector(
			'[data-attendance="no"]'
		);

		const attendanceDetails = document.querySelector(
			"#attendance-details"
		);

		const guestNames = document.querySelector(
			"#guest-names"
		);

		function updateAttendanceDetails() {
			if (
				!(yesRadio instanceof HTMLInputElement) ||
				!(attendanceDetails instanceof HTMLElement) ||
				!(guestNames instanceof HTMLTextAreaElement)
			) {
				return;
			}

			if (yesRadio.checked) {
				attendanceDetails.classList.remove("hidden");

				guestNames.disabled = false;
				guestNames.required = true;
			} else {
				attendanceDetails.classList.add("hidden");

				guestNames.disabled = true;
				guestNames.required = false;
				guestNames.value = "";

				const sundayRadios =
					attendanceDetails.querySelectorAll(
						'input[name="Présence dimanche"]'
					);

				sundayRadios.forEach((radio) => {
					if (radio instanceof HTMLInputElement) {
						radio.checked = false;
					}
				});

				const dietary = document.querySelector("#dietary");

				if (dietary instanceof HTMLTextAreaElement) {
					dietary.value = "";
				}
			}
		}

		yesRadio?.addEventListener(
			"change",
			updateAttendanceDetails
		);

		noRadio?.addEventListener(
			"change",
			updateAttendanceDetails
		);

		updateAttendanceDetails();
	</script>
</BaseLayout>
