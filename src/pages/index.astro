---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
	title="Jeanne & Maxime — Notre mariage"
	description="Le mariage de Jeanne & Maxime — 4 septembre 2027"
	language="fr"
	frenchUrl="/"
	englishUrl="/en/"
	fullBleed
>

			<!-- Hero -->
			<section
				class="relative flex min-h-screen items-center justify-center px-6 py-24 sm:px-16"
			>
				<!-- Watercolor lilies -->
				<img
					src={`${base}/images/lilies.png`}
					alt=""
					aria-hidden="true"
					class="pointer-events-none absolute right-0 top-0 z-0 w-[260px] select-none sm:w-[380px] lg:w-[500px]"
				/>

				<!-- Couple photo -->
				<img
					src={`${base}/images/jeanne-maxime-polaroid.png`}
					alt="Jeanne et Maxime"
					class="pointer-events-none absolute
						left-[-30px] top-[210px] z-0
						hidden w-[340px]
						md:block
						lg:left-[-20px] lg:top-[240px] lg:w-[400px]
						xl:left-[-10px] xl:top-[260px] xl:w-[440px]"
				/>

				<div class="relative z-10 mx-auto w-full min-w-0 max-w-4xl text-center">
					<p
						class="font-serif text-sm uppercase tracking-[0.45em] text-[var(--sage)] sm:text-base"
					>
						Notre mariage
					</p>

					<div class="my-6 text-7xl leading-[0.9] text-[var(--terracotta)] sm:text-8xl lg:text-9xl">
						<span class="block font-script lg:inline">Jeanne</span>
						<span class="block font-serif text-3xl leading-none sm:text-4xl lg:inline lg:text-5xl">&amp;</span>
						<span class="block font-script lg:inline">Maxime</span>
					</div>

					<div
						class="mx-auto my-8 h-px w-20 bg-[var(--terracotta)]/60"
					></div>

					<p
						class="font-serif text-xl uppercase tracking-[0.18em] text-[var(--olive)] sm:text-3xl sm:tracking-[0.25em]"
					>
						Samedi 4 septembre 2027
					</p>

					<p
						class="mt-5 font-serif text-base italic text-[var(--sage)] sm:text-xl"
					>
						Saint-Cyr-du-Gault · Loir-et-Cher
					</p>

					<a
						href="#bienvenue"
						class="mt-14 inline-block border border-[var(--terracotta)] px-7 py-3
						font-serif text-lg text-[var(--terracotta-dark)]
						transition-all duration-300
						hover:bg-[var(--terracotta)] hover:text-[var(--paper)]"
					>
						Découvrir
					</a>
				</div>

				<div
					class="pointer-events-none absolute -bottom-20 -left-20 h-80 w-80 rounded-full bg-[var(--terracotta)]/10 blur-3xl"
				></div>
			</section>

			<!-- Welcome -->
			<section
				id="bienvenue"
				class="relative px-8 pt-20 pb-12 sm:px-16 sm:pt-24 sm:pb-14"
			>
				<div class="mx-auto max-w-3xl text-center">
					<p
						class="font-serif text-sm uppercase tracking-[0.4em] text-[var(--sage)]"
					>
						Informations pratiques
					</p>

					<h2
						class="mt-5 font-serif text-5xl text-[var(--olive)] sm:text-6xl"
					>
						Rendez-vous en septembre
					</h2>

					<div
						class="mx-auto my-8 h-px w-16 bg-[var(--terracotta)]/60"
					></div>

					<p
						class="font-serif text-xl leading-relaxed text-[var(--text)] sm:text-2xl"
					>
						Le programme, les informations d’accès et nos recommandations
						pour organiser votre week-end dans le Loir-et-Cher.
					</p>
				</div>
			</section>

			<!-- Navigation -->
			<section id="menu" class="px-8 pb-16 sm:px-16">
				<div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2">
					<!-- Wedding -->
					<a
						href={`${base}/mariage`}
						class="editorial-card"
					>
						<p class="mb-4 text-xs tracking-[0.25em] text-[var(--terracotta-dark)]">01</p>
						<p class="font-serif text-3xl text-[var(--olive)]">
							Le mariage
						</p>

						<p
							class="mt-3 text-sm tracking-wide text-[var(--sage)]"
						>
							Programme &amp; déroulement
						</p>
					</a>

					<!-- Venue -->
					<a
						href={`${base}/lieu`}
						class="editorial-card"
					>
						<p class="mb-4 text-xs tracking-[0.25em] text-[var(--terracotta-dark)]">02</p>
						<p class="font-serif text-3xl text-[var(--olive)]">
							Le lieu
						</p>

						<p
							class="mt-3 text-sm tracking-wide text-[var(--sage)]"
						>
							Accès &amp; informations pratiques
						</p>
					</a>

					<!-- Weekend -->
					<a
						href={`${base}/weekend`}
						class="editorial-card"
					>
						<p class="mb-4 text-xs tracking-[0.25em] text-[var(--terracotta-dark)]">03</p>
						<p
							class="font-serif text-3xl text-[var(--olive)]"
						>
							Le week-end
						</p>

						<p
							class="mt-3 text-sm tracking-wide text-[var(--sage)]"
						>
							Hébergement, bonnes adresses &amp; activités
						</p>
					</a>

					<!-- RSVP -->
					<a
						href={`${base}/rsvp`}
						class="editorial-card"
					>
						<p class="mb-4 text-xs tracking-[0.25em] text-[var(--terracotta-dark)]">04</p>
						<p
							class="font-serif text-3xl text-[var(--olive)]"
						>
							RSVP
						</p>

						<p
							class="mt-3 text-sm tracking-wide text-[var(--sage)]"
						>
							Confirmer votre présence
						</p>
					</a>
				</div>

				<!-- Honeymoon shortcut -->
				<div class="mx-auto mt-5 max-w-2xl">
					<a
						href="#cagnotte"
						class="editorial-card"
					>
						<p class="mb-4 text-xs tracking-[0.25em] text-[var(--terracotta-dark)]">05</p>
						<p
							class="font-serif text-3xl text-[var(--olive)]"
						>
							Le voyage de noces
						</p>

						<p
							class="mt-3 text-sm tracking-wide text-[var(--sage)]"
						>
							Participer à notre cagnotte
						</p>
					</a>
				</div>
			</section>

			<!-- Visual separator -->
			<div
				class="mx-auto flex max-w-3xl items-center gap-5 px-8 py-12"
			>
				<div class="h-px flex-1 bg-[var(--sage)]/20"></div>

				<span class="font-serif text-sm tracking-[0.3em] text-[var(--terracotta-dark)]">J · M</span>

				<div class="h-px flex-1 bg-[var(--sage)]/20"></div>
			</div>

			<!-- Honeymoon fund -->
			<section
				id="cagnotte"
				class="relative scroll-mt-16 overflow-hidden px-8 pb-32 pt-12 sm:px-16"
			>
				<div
					class="mx-auto max-w-4xl border border-[var(--terracotta)]/30 bg-[var(--paper)]/40 px-8 py-16 text-center sm:px-16 sm:py-20"
				>
					<p
						class="font-serif text-sm uppercase tracking-[0.4em] text-[var(--sage)]"
					>
						Voyage de noces
					</p>

					<h2
						class="mt-5 font-serif text-4xl text-[var(--olive)] sm:text-5xl"
					>
						Voyage de noces
					</h2>

					<div
						class="mx-auto my-8 h-px w-16 bg-[var(--terracotta)]/60"
					></div>

					<p
						class="mx-auto max-w-2xl font-serif text-xl leading-relaxed text-[var(--sage)]"
					>
						Nous avons déjà tout ce qu’il nous faut à la maison, alors
						plutôt qu’une liste de mariage, nous avons choisi de mettre
						en place une cagnotte pour notre voyage de noces.
					</p>

					<p
						class="mx-auto mt-4 max-w-2xl font-serif text-xl leading-relaxed text-[var(--sage)]"
					>
						Si vous souhaitez participer, vous trouverez la cagnotte ci-dessous.
						Votre présence reste, bien sûr, l’essentiel.
					</p>

					<a
						href="https://www.leetchi.com/fr/c/jeanne-max-1399369?u=dbc986d6-d0cd-4ca2-870c-01a03d16b4a9&utm_source=copylink&utm_medium=social_sharing"
						target="_blank"
						rel="noopener noreferrer"
						class="mt-10 inline-block bg-[var(--terracotta)] px-9 py-4
						font-serif text-lg text-white
						transition-all duration-300
						hover:-translate-y-1 hover:bg-[var(--terracotta-dark)]"
					>
						Participer à la cagnotte →
					</a>
				</div>
			</section>
</BaseLayout>
