---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Le mariage — Jeanne & Maxime"
	description="Le programme du mariage de Jeanne & Maxime."
	language="fr"
	frenchUrl="/mariage"
	englishUrl="/en/wedding"
	maxWidth="max-w-4xl"
>
	<a
		href="/#bienvenue"
		class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--sage)] transition-colors hover:text-[var(--terracotta)]"
	>
		← Retour
	</a>

	<header class="py-20 text-center">
		<p class="font-serif text-sm uppercase tracking-[0.4em] text-[var(--sage)]">
			4 septembre 2027
		</p>

		<h1 class="mt-5 font-serif text-6xl text-[var(--olive)] sm:text-7xl">
			Le mariage
		</h1>

		<div class="mx-auto my-8 h-px w-16 bg-[var(--terracotta)]/60"></div>

		<p class="font-serif text-xl italic text-[var(--sage)]">
			Une journée à célébrer ensemble
		</p>
	</header>

    <div class="flex justify-center pb-12">
        <img
            src="/images/champagne-lilies.png"
            alt=""
            aria-hidden="true"
            class="w-52 object-contain sm:w-64 lg:w-72"
        />
    </div>

	<section class="grid gap-10 py-10 md:grid-cols-2">
		<div class="border border-[var(--sage)]/25 bg-[var(--paper)]/60 p-8">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--terracotta)]">
				14h30
			</p>

			<h2 class="mt-3 font-serif text-3xl text-[var(--olive)]">
				La cérémonie
			</h2>

			<p class="mt-4 leading-relaxed text-[var(--sage)]">
				Les détails de la cérémonie seront ajoutés ici.
			</p>
		</div>

		<div class="border border-[var(--sage)]/25 bg-[var(--paper)]/60 p-8">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--terracotta)]">
				17h00
			</p>

			<h2 class="mt-3 font-serif text-3xl text-[var(--olive)]">
				Le cocktail
			</h2>

			<p class="mt-4 leading-relaxed text-[var(--sage)]">
				Un moment pour profiter, trinquer et se retrouver.
			</p>
		</div>

		<div class="border border-[var(--sage)]/25 bg-[var(--paper)]/60 p-8">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--terracotta)]">
				20h00
			</p>

			<h2 class="mt-3 font-serif text-3xl text-[var(--olive)]">
				Le dîner
			</h2>

			<p class="mt-4 leading-relaxed text-[var(--sage)]">
				Le dîner et les festivités se poursuivront sur place.
			</p>
		</div>

		<div class="border border-[var(--sage)]/25 bg-[var(--paper)]/60 p-8">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--terracotta)]">
				Jusqu’au bout de la nuit
			</p>

			<h2 class="mt-3 font-serif text-3xl text-[var(--olive)]">
				La soirée
			</h2>

			<p class="mt-4 leading-relaxed text-[var(--sage)]">
				Préparez vos meilleurs pas de danse.
			</p>
		</div>
	</section>
</BaseLayout>
