---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
	title="RSVP — Jeanne & Maxime"
	description="Confirmez votre présence au mariage de Jeanne & Maxime."
	language="fr"
	frenchUrl="/rsvp"
	englishUrl="/en/rsvp"
	maxWidth="max-w-2xl"
>
	<a
		href="/#menu"
		class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--sage)] transition-colors hover:text-[var(--terracotta)]"
	>
		← Retour
	</a>

	<header class="py-20 text-center">
		<p class="font-serif text-sm uppercase tracking-[0.4em] text-[var(--sage)]">
			Nous espérons vous retrouver
		</p>

		<h1 class="mt-5 font-serif text-6xl text-[var(--olive)] sm:text-7xl">
			RSVP
		</h1>

		<div class="mx-auto my-8 h-px w-16 bg-[var(--terracotta)]/60"></div>

		<p class="font-serif text-xl text-[var(--sage)]">
			Merci de nous répondre avant le 1er juin 2027.
		</p>
	</header>

	<!-- Keep your current form here -->
</BaseLayout>