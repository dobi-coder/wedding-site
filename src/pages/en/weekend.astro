---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Le week-end — Jeanne & Maxime"
	description="Informations pratiques pour le week-end du mariage."
	language="fr"
	frenchUrl="/weekend"
	englishUrl="/en/weekend"
	maxWidth="max-w-4xl"
>
	<a
		href="/#menu"
		class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--sage)] transition-colors hover:text-[var(--terracotta)]"
	>
		← Retour
	</a>

	<header class="py-20 text-center">
		<p class="font-serif text-sm uppercase tracking-[0.4em] text-[var(--sage)]">
			Deux jours ensemble
		</p>

		<h1 class="mt-5 font-serif text-6xl text-[var(--olive)] sm:text-7xl">
			Le week-end
		</h1>

		<div class="mx-auto my-8 h-px w-16 bg-[var(--terracotta)]/60"></div>
	</header>

	<section class="space-y-12">
		<div class="border-l border-[var(--terracotta)] pl-8">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--terracotta)]">
				Samedi
			</p>

			<h2 class="mt-2 font-serif text-4xl text-[var(--olive)]">
				Le mariage
			</h2>

			<p class="mt-4 leading-relaxed text-[var(--sage)]">
				La cérémonie, le cocktail, le dîner et la soirée.
			</p>
		</div>

		<div class="border-l border-[var(--terracotta)] pl-8">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-[var(--terracotta)]">
				Dimanche
			</p>

			<h2 class="mt-2 font-serif text-4xl text-[var(--olive)]">
				Le retour de noces
			</h2>

			<p class="mt-4 leading-relaxed text-[var(--sage)]">
				Nous vous retrouverons le lendemain pour prolonger les festivités.
			</p>
		</div>
	</section>
</BaseLayout>