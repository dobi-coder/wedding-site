---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Jeanne & Maxime — Our wedding"
	description="Jeanne & Maxime’s wedding — 4 September 2027"
	language="en"
	frenchUrl="/"
	englishUrl="/en/"
	fullBleed
>

			<!-- Hero -->
			<section
				class="relative flex min-h-screen items-center justify-center px-8 py-24 sm:px-16"
			>
				<!-- Watercolor lilies -->
				<img
					src="/images/lilies.png"
					alt=""
					aria-hidden="true"
					class="pointer-events-none absolute right-0 top-0 z-0 w-[260px] select-none sm:w-[380px] lg:w-[500px]"
				/>

				<div class="relative z-10 mx-auto max-w-4xl text-center">
					<p
						class="font-serif text-sm uppercase tracking-[0.45em] text-[var(--sage)] sm:text-base"
					>
						Our wedding
					</p>

					<div class="my-6 text-7xl text-[var(--terracotta)] sm:text-9xl">
						<span class="font-script">Jeanne</span>
						<span class="font-serif text-4xl sm:text-5xl">&amp;</span>
						<span class="font-script">Maxime</span>
					</div>

					<div
						class="mx-auto my-8 h-px w-20 bg-[var(--terracotta)]/60"
					></div>

					<p
						class="font-serif text-2xl uppercase tracking-[0.25em] text-[var(--olive)] sm:text-3xl"
					>
						Saturday, 4 September 2027
					</p>

					<p
						class="mt-5 font-serif text-lg italic text-[var(--sage)] sm:text-xl"
					>
						Two days of celebrating together
					</p>

					<a
						href="#welcome"
						class="mt-14 inline-block border border-[var(--terracotta)] px-7 py-3
						font-serif text-lg text-[var(--terracotta-dark)]
						transition-all duration-300
						hover:bg-[var(--terracotta)] hover:text-[var(--paper)]"
					>
						Discover
					</a>
				</div>

				<div
					class="pointer-events-none absolute -bottom-20 -left-20 h-80 w-80 rounded-full bg-[var(--terracotta)]/10 blur-3xl"
				></div>
			</section>

			<!-- Welcome -->
			<section
				id="welcome"
				class="relative px-8 pt-20 pb-12 sm:px-16 sm:pt-24 sm:pb-14"
			>
				<div class="mx-auto max-w-3xl text-center">
					<p
						class="font-serif text-sm uppercase tracking-[0.4em] text-[var(--sage)]"
					>
						We can’t wait
					</p>

					<h2
						class="mt-5 font-serif text-5xl text-[var(--olive)] sm:text-6xl"
					>
						To celebrate with you
					</h2>

					<div
						class="mx-auto my-8 h-px w-16 bg-[var(--terracotta)]/60"
					></div>

					<p
						class="font-serif text-xl leading-relaxed text-[var(--text)] sm:text-2xl"
					>
						We’re so happy to share these two special days with you. Here you’ll find everything you need to plan this wonderful weekend with us.
					</p>
				</div>
			</section>

			<!-- Navigation -->
			<section id="menu" class="px-8 pb-16 sm:px-16">
				<div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2">
					<!-- Wedding -->
					<a
						href="/en/wedding"
						class="group border border-[var(--sage)]/30 bg-[var(--paper)]/50 p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-[var(--terracotta)] hover:bg-[var(--terracotta)]"					>
						<p class="font-serif text-3xl text-[var(--olive)]">
							The wedding
						</p>

						<p
							class="mt-3 text-sm tracking-wide text-[var(--sage)] transition-colors group-hover:text-white/80"
						>
							Schedule &amp; details
						</p>
					</a>

					<!-- Venue -->
					<a
						href="/en/venue"
						class="group border border-[var(--sage)]/30 bg-[var(--paper)]/50 p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-[var(--terracotta)] hover:bg-[var(--terracotta)]"					>
						<p class="font-serif text-3xl text-[var(--olive)]">
							The venue
						</p>

						<p
							class="mt-3 text-sm tracking-wide text-[var(--sage)] transition-colors group-hover:text-white/80"
						>
							Travel &amp; practical information
						</p>
					</a>

					<!-- Weekend -->
					<a
						href="/en/weekend"
						class="group border border-[var(--sage)]/30 bg-[var(--paper)]/50 p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-[var(--terracotta)] hover:bg-[var(--terracotta)]"					>
						<p
							class="font-serif text-3xl text-[var(--olive)] transition-colors group-hover:text-white"
						>
							The weekend
						</p>

						<p
							class="mt-3 text-sm tracking-wide text-[var(--sage)] transition-colors group-hover:text-white/80"
						>
							Accommodation, local tips &amp; activities
						</p>
					</a>

					<!-- RSVP -->
					<a
						href="/en/rsvp"
						class="group border border-[var(--sage)]/30 bg-[var(--paper)]/50 p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-[var(--terracotta)] hover:bg-[var(--terracotta)]"					>
						<p
							class="font-serif text-3xl text-[var(--olive)] transition-colors group-hover:text-white"
						>
							RSVP
						</p>

						<p
							class="mt-3 text-sm tracking-wide text-[var(--sage)] transition-colors group-hover:text-white/80"
						>
							Confirm your attendance
						</p>
					</a>
				</div>

				<!-- Honeymoon shortcut -->
				<div class="mx-auto mt-5 max-w-2xl">
					<a
						href="#honeymoon"
							class="group block border border-[var(--sage)]/30 bg-[var(--paper)]/50 px-8 py-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-[var(--terracotta)] hover:bg-[var(--terracotta)]"					>
						<p
							class="font-serif text-2xl text-[var(--olive)] transition-colors group-hover:text-white"
						>
							Honeymoon
						</p>

						<p
							class="mt-2 text-sm tracking-wide text-[var(--sage)] transition-colors group-hover:text-white/80"
						>
							Contribute to our honeymoon fund
						</p>
					</a>
				</div>
			</section>

			<!-- Visual separator -->
			<div
				class="mx-auto flex max-w-3xl items-center gap-5 px-8 py-12"
			>
				<div class="h-px flex-1 bg-[var(--sage)]/20"></div>

				<span class="text-lg text-[var(--terracotta)]">
					♥
				</span>

				<div class="h-px flex-1 bg-[var(--sage)]/20"></div>
			</div>

			<!-- Honeymoon fund -->
			<section
				id="honeymoon"
				class="scroll-mt-16 px-8 pb-32 pt-12 sm:px-16"
			>
				<div
					class="mx-auto max-w-4xl border border-[var(--terracotta)]/30 bg-[var(--paper)]/40 px-8 py-16 text-center sm:px-16 sm:py-20"
				>
					<p
						class="font-serif text-sm uppercase tracking-[0.4em] text-[var(--sage)]"
					>
						Honeymoon
					</p>

					<h2
						class="mt-5 font-serif text-4xl text-[var(--olive)] sm:text-5xl"
					>
						Our next adventure
					</h2>

					<div
						class="mx-auto my-8 h-px w-16 bg-[var(--terracotta)]/60"
					></div>

					<p
						class="mx-auto max-w-2xl font-serif text-xl leading-relaxed text-[var(--sage)]"
					>
						We already have everything we need at home, so instead of a
						wedding registry, we’ve created a fund for our honeymoon.
					</p>

					<p
						class="mx-auto mt-4 max-w-2xl font-serif text-xl leading-relaxed text-[var(--sage)]"
					>
						If you’d like to contribute to our next adventure, you can do so here. There’s absolutely no obligation—we’re already delighted to have you with us for the wedding!
					</p>

					<a
						href="https://www.leetchi.com/fr/c/jeanne-max-1399369?u=dbc986d6-d0cd-4ca2-870c-01a03d16b4a9&utm_source=copylink&utm_medium=social_sharing"
						target="_blank"
						rel="noopener noreferrer"
						class="mt-10 inline-block bg-[var(--terracotta)] px-9 py-4
						font-serif text-lg text-white
						transition-all duration-300
						hover:-translate-y-1 hover:bg-[var(--terracotta-dark)]"
					>
						Contribute to the fund →
					</a>
				</div>
			</section>
</BaseLayout>
