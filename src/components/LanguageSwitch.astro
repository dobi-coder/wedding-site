---
interface Props {
	currentLanguage: "fr" | "en";
	frenchUrl: string;
	englishUrl: string;
}

const {
	currentLanguage,
	frenchUrl,
	englishUrl,
} = Astro.props;
---

<div class="fixed bottom-8 right-8 z-30 flex items-center gap-2 border border-[var(--terracotta)]/40 bg-[var(--paper)]/90 px-4 py-3 font-serif text-sm uppercase tracking-[0.2em] shadow-sm backdrop-blur-sm sm:bottom-10 sm:right-10">
	{
		currentLanguage === "fr" ? (
			<>
				<span class="text-[var(--olive)]">FR</span>
				<span class="text-[var(--sage)]/40">|</span>
				<a
					href={englishUrl}
					class="text-[var(--terracotta-dark)] transition-colors hover:text-[var(--terracotta)]"
				>
					EN
				</a>
			</>
		) : (
			<>
				<a
					href={frenchUrl}
					class="text-[var(--terracotta-dark)] transition-colors hover:text-[var(--terracotta)]"
				>
					FR
				</a>
				<span class="text-[var(--sage)]/40">|</span>
				<span class="text-[var(--olive)]">EN</span>
			</>
		)
	}
</div>
